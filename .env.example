# This is an example .env file.
# Copy this to a new file named .env and fill in your actual values.
# DO NOT commit the .env file to version control.

# --- Backend Configuration ---

# The secret key used for signing JWTs. Should be a long, random string.
# Generate one with: openssl rand -hex 32
SECRET_KEY="your_very_strong_random_secret_key_for_jwt"

# The full URL to your database. Defaults to a local SQLite file if not set.
# Example for PostgreSQL: DATABASE_URL="postgresql://user:pass@localhost:5432/dbname"
# Example for SQLite (default): DATABASE_URL="sqlite:///./test.db"
DATABASE_URL="sqlite:///./test.db"

# --- OpenAI API Configuration (Optional) ---
# Required only for the "Text Humanizer" feature.
OPENAI_API_KEY="sk-..."

# --- Stripe Configuration (Optional) ---
# Required only for the subscription/payment features.
# Get your keys from the Stripe Dashboard (Developers -> API keys).
STRIPE_API_KEY="sk_test_..."

# Get your webhook secret from the Stripe Dashboard (Developers -> Webhooks -> Your Endpoint)
# Or from the `stripe listen` command for local testing.
STRIPE_WEBHOOK_SECRET="whsec_..."

# Get these from your created Products in the Stripe Dashboard.
STRIPE_PRICE_ID_PRO_BASIC="price_..."
STRIPE_PRICE_ID_PRO_ADVANCED="price_..."

# --- Frontend Configuration ---
# Base URL of the frontend application, used for Stripe redirects.
FRONTEND_URL="http://localhost:3000"

# --- Frontend Environment Variables (.env.local in /frontend) ---
# While not part of this file, the frontend uses its own .env.local for public keys.
# NEXT_PUBLIC_API_BASE_URL="http://127.0.0.1:8000"
